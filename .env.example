# Required at BUILD time on Vercel (Production + Preview scopes).
# The build fails fast with a clear error when these are empty.
# Use the POOLER (Supabase PgBouncer, :6543) at runtime and the DIRECT
# connection (:5432) for `prisma migrate deploy`.
DATABASE_URL="postgresql://joud:joud_dev_pass@localhost:5432/joud_dev?schema=public&connection_limit=10"
DIRECT_DATABASE_URL="postgresql://joud:joud_dev_pass@localhost:5432/joud_dev?schema=public"
# Required at build time (inlined into metadata/canonical URLs).
# Must be a full https:// origin in production. VERCEL_PROJECT_PRODUCTION_URL
# / VERCEL_URL are automatic fallbacks — do not rely on them for canonical SEO.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated extra origins allowed to call mutating /api/* routes
# (e.g. preview aliases, alternate domains). Same-origin POSTs send an
# Origin header, so every domain serving the app must be listed.
ALLOWED_ORIGINS=https://joud-real-estate.vercel.app
NEXT_PUBLIC_APP_NAME=جود العقارية
NEXT_PUBLIC_R2_CDN_URL=https://images.joud.sa
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL=http://localhost:3000
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@joud.sa
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=joud-images
R2_PUBLIC_URL=https://images.joud.sa
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx
HCAPTCHA_SECRET=xxx
HCAPTCHA_SECRET_KEY=xxx
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=xxx
# Free alternative to hCaptcha (no account needed to run without captcha;
# add these to enable Cloudflare Turnstile bot protection instead).
TURNSTILE_SECRET_KEY=turnstile_xxx
NEXT_PUBLIC_TURNSTILE_SITE_KEY=turnstile_xxx
REVALIDATE_SECRET=replace-with-random-32-characters
CRON_SECRET=replace-with-random-32-characters
# Sentry release/upload (Production + Preview, build time). All three are
# required together or source-map upload warns and is skipped.
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ORG=loay-ww
SENTRY_PROJECT=javascript-nextjs-71
SENTRY_AUTH_TOKEN=sntrys_xxx
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
R2_BACKUP_BUCKET_NAME=joud-backups
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-web-push-public-key
VAPID_PRIVATE_KEY=replace-with-web-push-private-key
VAPID_SUBJECT=mailto:admin@joud.sa
PEXELS_API_KEY=pexels_xxx
