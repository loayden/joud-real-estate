{
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/expire-listings",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/backup-notification",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/price-alerts",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
